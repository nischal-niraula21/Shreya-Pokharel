# Copy to .env at the project root. Never commit .env or share its contents.
MONGODB_URI=mongodb://127.0.0.1:27017/shreya_bookshop
PORT=3000
# npm run dev serves the React app at this origin.
# For npm start after npm run build, change to http://localhost:3000 locally.
# In production, set your actual HTTPS website origin, without a trailing slash.
APP_ORIGIN=http://localhost:5173
# Required on the first startup. Choose a unique password of at least 12 characters.
ADMIN_PASSWORD=
NODE_ENV=development
# Leave 0 locally. Set to the exact number of trusted reverse proxies if needed.
TRUST_PROXY=0
# Optional local DNS workaround; leave unset on Render unless DNS lookup fails.
MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
# Resend is intentionally disconnected. No email is sent with EMAIL_MODE=off.
EMAIL_MODE=off
ADMIN_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Required for new QR-payment screenshots. COD works before Cloudinary is connected.
# Server-only values from your Cloudinary product environment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=shreya/payment-proofs
