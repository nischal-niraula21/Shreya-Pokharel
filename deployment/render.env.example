# Copy VALUES into Render's Environment dashboard. Never commit real values.
# Use raw values in the dashboard, without surrounding quote characters.
NODE_ENV=production
APP_ORIGIN=https://YOUR-PRODUCTION-FRONTEND.vercel.app
TRUST_PROXY=1
MONGODB_URI=YOUR_COMPLETE_ATLAS_CONNECTION_STRING
ADMIN_PASSWORD=YOUR_EXISTING_ADMIN_PASSWORD
ADMIN_EMAIL=YOUR_WORKING_EMAIL
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_ROTATED_API_SECRET
CLOUDINARY_FOLDER=portbook
EMAIL_MODE=off
# Add later when connecting Resend:
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_REPLY_TO=
# Optional only if Render itself has DNS trouble:
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
# Render supplies PORT. Do not copy your local PORT or localhost APP_ORIGIN.
